---
import { getImage, Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { SITE } from '../lib/site';
import { url } from '../lib/url';
import '../styles/global.css';

type Section = 'home' | 'marketplace' | 'docs' | 'blog' | 'support';

interface Props {
  title?: string;
  description?: string;
  active?: Section;
  noindex?: boolean;
  image?: string;
}

const { title = SITE.title, description = SITE.description, active, noindex = false, image = '/og.png' } = Astro.props;

const favicon = await getImage({ src: logo, width: 64, height: 64, format: 'png' });
const touchIcon = await getImage({ src: logo, width: 180, height: 180, format: 'png' });
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);

const nav: { label: string; href: string; section: Section }[] = [
  { label: 'Marketplace', href: url('/marketplace/'), section: 'marketplace' },
  { label: 'Docs', href: url('/docs/'), section: 'docs' },
  { label: 'Blog', href: url('/blog/'), section: 'blog' },
  { label: 'Support', href: url('/support/'), section: 'support' },
];

const footer: { heading: string; links: { label: string; href: string; external?: boolean }[] }[] = [
  {
    heading: 'Products',
    links: [
      { label: 'Donation Board', href: url('/products/donationboard/') },
      { label: 'Nexus Dynamics', href: url('/products/nexusdynamics/') },
      { label: 'Axis Indicator', href: url('/products/axisindicator/') },
      { label: 'Marketplace', href: url('/marketplace/') },
    ],
  },
  {
    heading: 'Resources',
    links: [
      { label: 'Documentation', href: url('/docs/') },
      { label: 'Blog', href: url('/blog/') },
      { label: 'Support', href: url('/support/') },
      { label: 'Licenses', href: url('/terms/') },
      // { label: 'Sell on Dev Equip', href: url('/sell/') },
    ],
  },
  {
    heading: 'Community',
    links: [
      { label: 'Discord', href: SITE.discord, external: true },
      { label: 'GitHub', href: SITE.github, external: true },
      { label: 'YouTube', href: SITE.youtube, external: true },
      { label: 'X', href: SITE.x, external: true },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050b16" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="min-h-screen text-fg flex flex-col font-sans">
      <header class="sticky top-3 z-40 w-full px-4 sm:px-6">
        <div class="max-w-4xl mx-auto pl-4 pr-2 h-12 flex items-center justify-between gap-4 rounded-lg border border-white/[0.08] bg-[#0b0c13]/90 backdrop-blur-md">
          <a href={url('/')} class="flex items-center gap-2 select-none rounded-md" aria-label="Dev Equip home">
            <Image src={logo} alt="" width={56} height={56} loading="eager" class="w-6 h-6 object-contain" />
            <span class="text-[15px] font-semibold tracking-tight text-zinc-50 font-display">Dev Equip</span>
          </a>

          <nav class="hidden md:flex items-center gap-0.5" aria-label="Main">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class:list={['nav-link', { 'nav-active': active === item.section }]}
                  aria-current={active === item.section ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>

          <button
            id="menu-toggle"
            type="button"
            class="md:hidden p-2 rounded text-zinc-300 hover:text-white hover:bg-white/10 cursor-pointer"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
              <path class="menu-open-icon" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
              <path class="menu-close-icon hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <nav id="mobile-menu" class="hidden md:hidden max-w-4xl mx-auto mt-2 p-2 rounded-lg border border-white/[0.08] bg-[#0b0c13]/95 backdrop-blur-md" aria-label="Mobile">
          <div class="flex flex-col gap-1">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  class:list={['nav-link !py-2.5 !text-sm', { 'nav-active': active === item.section }]}
                  aria-current={active === item.section ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </nav>
      </header>

      <main id="main" class="flex-grow pt-4">
        <slot />
      </main>

      <footer class="w-full mt-auto border-t border-line">
        <div class="container-site pt-10 pb-8 flex flex-col md:flex-row md:justify-between gap-10">
          <div>
            <a href={url('/')} class="inline-flex items-center gap-2" aria-label="Dev Equip home">
              <Image src={logo} alt="" width={56} height={56} class="w-5 h-5 object-contain" />
              <span class="text-sm font-semibold text-fg">Dev Equip</span>
            </a>
            <p class="mt-2 text-sm text-fg-3">© {new Date().getFullYear()} Dev Equip</p>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-x-16 gap-y-8 text-sm">
            {
              footer.map((col) => (
                <div>
                  <h2 class="font-medium text-fg mb-3">{col.heading}</h2>
                  <ul class="flex flex-col gap-2 text-fg-3">
                    {col.links.map((link) => (
                      <li>
                        <a
                          href={link.href}
                          class="hover:text-fg transition-colors"
                          target={link.external ? '_blank' : undefined}
                          rel={link.external ? 'noopener noreferrer' : undefined}
                        >
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </footer>
    </div>

    <script>
      import Lenis from 'lenis';
      import Snap from 'lenis/snap';
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({ autoRaf: true, allowNestedScroll: true, anchors: { offset: -88 } });

        const screens = [...document.querySelectorAll<HTMLElement>('.screen')];
        if (screens.length) {
          const snap = new Snap(lenis, { type: 'proximity', distanceThreshold: '20%', debounce: 250, duration: 0.6 });
          for (const screen of screens) {
            snap.addElement(screen, { align: screen.offsetHeight > innerHeight + 1 ? 'start' : 'center' });
          }
        }
      }

      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        for (const item of document.querySelectorAll<HTMLDetailsElement>('details.faq')) {
          const summary = item.querySelector('summary')!;
          const answer = summary.nextElementSibling as HTMLElement;
          let running: Animation | null = null;
          summary.addEventListener('click', (e) => {
            e.preventDefault();
            running?.cancel();
            if (!item.open || item.classList.contains('closing')) {
              item.classList.remove('closing');
              item.open = true;
              const { height, paddingBottom } = getComputedStyle(answer);
              running = answer.animate(
                [
                  { height: '0px', paddingBottom: '0px', opacity: 0 },
                  { height, paddingBottom, opacity: 1 },
                ],
                { duration: 320, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' },
              );
            } else {
              item.classList.add('closing');
              const { height, paddingBottom } = getComputedStyle(answer);
              running = answer.animate(
                [
                  { height, paddingBottom, opacity: 1 },
                  { height: '0px', paddingBottom: '0px', opacity: 0 },
                ],
                { duration: 240, easing: 'cubic-bezier(0.4, 0, 1, 1)' },
              );
              running.onfinish = () => {
                item.open = false;
                item.classList.remove('closing');
              };
            }
          });
        }
      }

      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      toggle?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.querySelector('.menu-open-icon')?.classList.toggle('hidden', open);
        toggle.querySelector('.menu-close-icon')?.classList.toggle('hidden', !open);
      });
    </script>
  </body>
</html>
