---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate, getPosts, readingTime } from '../../lib/blog';
import { SITE } from '../../lib/site';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Dev Equip`} description={post.data.description} active="blog">
  <article>
    <header class="container-site max-w-3xl pt-6 sm:pt-8">
      <a href={url('/blog/')} class="inline-flex items-center gap-1.5 mb-6 text-sm text-fg-3 hover:text-fg transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Blog
      </a>
      <h1 class="page-title break-words">{post.data.title}</h1>
      <p class="page-lead">{post.data.description}</p>
      <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-fg-3">
        <span class="text-fg-2">{post.data.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post)}</span>
        {post.data.draft && <><span aria-hidden="true">·</span><span class="text-amber-400">Draft</span></>}
        {post.data.tags.map((tag) => (
          <><span aria-hidden="true">·</span><a href={url(`/blog/?tag=${encodeURIComponent(tag)}`)} class="hover:text-fg">{tag}</a></>
        ))}
      </div>
    </header>

    <div class="container-site max-w-3xl pt-10 pb-16">
      <div class="prose">
        <Content />
      </div>

      <div class="flex gap-3 px-4 py-3.5 mt-14 rounded-lg border border-line bg-panel text-sm">
        <p class="text-fg-2">
          <span class="text-fg font-semibold">Questions about this post? </span>
          Ask in the <a href={SITE.discord} class="text-brand-2 hover:text-fg underline underline-offset-2" target="_blank" rel="noopener noreferrer">Discord</a>.
        </p>
      </div>

      {
        (newer || older) && (
          <nav aria-label="More posts" class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-10">
            {older ? (
              <a href={url(`/blog/${older.id}/`)} class="card card-link group block p-5">
                <span class="block text-xs text-fg-3 mb-1.5">&larr; Older post</span>
                <span class="block font-semibold text-fg group-hover:text-brand-2 transition-colors break-words">{older.data.title}</span>
              </a>
            ) : <div class="hidden sm:block" />}
            {newer && (
              <a href={url(`/blog/${newer.id}/`)} class="card card-link group block p-5 sm:text-right">
                <span class="block text-xs text-fg-3 mb-1.5">Newer post &rarr;</span>
                <span class="block font-semibold text-fg group-hover:text-brand-2 transition-colors break-words">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </div>
  </article>
</Layout>
