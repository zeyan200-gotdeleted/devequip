{
  "name": "dev-equip",
  "description": "Dev Equip: a marketplace of developer tools, UI kits and boilerplates, built with Astro and deployed to GitHub Pages.",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:vps": "node scripts/build-vps.mjs",
    "preview": "astro preview",
    "start": "serve dist --listen ${PORT:-1423} --no-clipboard",
    "astro": "astro",
    "check": "astro check && vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vue-tsc": "^3.3.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
